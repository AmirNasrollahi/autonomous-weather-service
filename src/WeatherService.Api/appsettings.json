{
  "ConnectionStrings": {
    "WeatherDb": "Data Source=weather.db;Cache=Shared"
  },
  "WeatherApi": {
    "BaseUrl": "https://api.open-meteo.com/v1/forecast",
    "Hourly": "temperature_2m",
    "TimeoutSeconds": 2.5,
    "CacheTtlMinutes": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
